# FAHIN Backend — Environment Variables Example
# Copy to .env and fill in your values

# ── App ─────────────────────────────────────────────────────────────────────
APP_NAME=FAHIN
DEBUG=True
SECRET_KEY=dev-secret-key-replace-in-production-must-be-32-chars

# ── Database (Supabase or local PostgreSQL) ──────────────────────────────────
DATABASE_URL=postgresql+asyncpg://fahin_user:fahin_secret@localhost:5432/fahin

# ── Supabase ─────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-anon-key-here
SUPABASE_SERVICE_KEY=your-service-role-key-here

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── AI (OpenAI) ──────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-your-openai-key-here
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# ── Federated Learning (Flower) ──────────────────────────────────────────────
FLOWER_SERVER_ADDRESS=0.0.0.0:8080

# ── External APIs ────────────────────────────────────────────────────────────
OPENAQ_API_KEY=your-openaq-key         # https://docs.openaq.org
OPENWEATHER_API_KEY=your-owm-key       # https://openweathermap.org/api

# ── Alert Thresholds ─────────────────────────────────────────────────────────
OUTBREAK_ALERT_THRESHOLD=0.70
ANOMALY_ALERT_THRESHOLD=3.0

# ── CORS ─────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:3001"]
ALLOWED_HOSTS=["*"]

# ── ML Model Paths ────────────────────────────────────────────────────────────
MODEL_DIR=../ml/models
DISEASE_CLASSIFIER_PATH=../ml/models/disease_classifier/ensemble.pkl
OUTBREAK_FORECASTER_PATH=../ml/models/outbreak_forecast/lstm.pt
ANOMALY_DETECTOR_PATH=../ml/models/anomaly_detection/autoencoder.pt
SYMPTOM_EMBEDDER_PATH=../ml/models/symptom_embedding/model.pt
